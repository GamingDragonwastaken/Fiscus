{
  "name": "fiscus",
  "version": "0.1.0",
  "description": "Local-first proxy that meters and caps what your AI coding agents spend — without sending a byte of your code anywhere.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "fiscus": "bin/fiscus.mjs"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/fiscus.mjs start",
    "aegis": "node --disable-warning=ExperimentalWarning bin/fiscus.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --disable-warning=ExperimentalWarning bin/fiscus.mjs demo --serve",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "files": [
    "bin",
    "src",
    "pricing",
    "baselines"
  ],
  "keywords": [
    "finops",
    "llm",
    "proxy",
    "tokens",
    "cost",
    "claude",
    "openai",
    "developer-productivity",
    "ai-governance"
  ],
  "author": "2am_seeker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GamingDragonwastaken/aegisflow.git"
  },
  "homepage": "https://github.com/GamingDragonwastaken/aegisflow#readme",
  "bugs": "https://github.com/GamingDragonwastaken/aegisflow/issues",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.7.0"
  }
}
